#!/usr/bin/env bash
# shellcheck disable=SC1091
set -x
date
rundir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
HOMErrfs="$(dirname "$rundir")"

module purge
source "${HOMErrfs}/workflow/tools/detect_machine.sh"
"${HOMErrfs}/workflow/tools/init.sh"

EXEC="${HOMErrfs}/sorc/MPASSIT/bin/mpassit"

rm -rf "${HOMErrfs}/sorc/MPASSIT/build"
rm -rf "${HOMErrfs}/sorc/MPASSIT/bin"

if [[ -d "${HOMErrfs}/sorc/_workaround_/MPASSIT" ]]; then
  mkdir -p "${HOMErrfs}/sorc/MPASSIT/modulefiles"
  [[ -f "${HOMErrfs}/sorc/_workaround_/MPASSIT/detect_machine.sh" ]] && cp "${HOMErrfs}/sorc/_workaround_/MPASSIT/detect_machine.sh" "${HOMErrfs}/sorc/MPASSIT/detect_machine.sh"
  [[ -f "${HOMErrfs}/sorc/_workaround_/MPASSIT/build.sh" ]] && cp "${HOMErrfs}/sorc/_workaround_/MPASSIT/build.sh" "${HOMErrfs}/sorc/MPASSIT/build.sh"
  [[ -f "${HOMErrfs}/sorc/_workaround_/MPASSIT/build.gaeac7.intel.lua" ]] && cp "${HOMErrfs}/sorc/_workaround_/MPASSIT/build.gaeac7.intel.lua" "${HOMErrfs}/sorc/MPASSIT/modulefiles/build.gaeac7.intel.lua"
fi

cd "${HOMErrfs}/sorc/MPASSIT" || exit 1
./build.sh

mkdir -p "${HOMErrfs}/exec"
echo "copy ${EXEC} to ../exec/mpassit.x"
cp "${EXEC}" "${HOMErrfs}/exec/mpassit.x"

exit 0
