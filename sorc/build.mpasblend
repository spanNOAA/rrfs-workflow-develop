#!/usr/bin/env bash
# shellcheck disable=SC1091
set -x
date
rundir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
HOMErrfs="$(dirname "$rundir")"

module purge
source "${HOMErrfs}/workflow/tools/detect_machine.sh"
"${HOMErrfs}/workflow/tools/init.sh"

EXEC="${HOMErrfs}/sorc/MPASBlend/bin/mpas_blending"

rm -rf "${HOMErrfs}/sorc/MPASBlend/build"
rm -rf "${HOMErrfs}/sorc/MPASBlend/bin"

if [[ -d "${HOMErrfs}/sorc/_workaround_/MPASBlend" ]]; then
  mkdir -p "${HOMErrfs}/sorc/MPASBlend/modulefiles"
  [[ -f "${HOMErrfs}/sorc/_workaround_/MPASBlend/detect_machine.sh" ]] && cp "${HOMErrfs}/sorc/_workaround_/MPASBlend/detect_machine.sh" "${HOMErrfs}/sorc/MPASBlend/detect_machine.sh"
  [[ -f "${HOMErrfs}/sorc/_workaround_/MPASBlend/build.sh" ]] && cp "${HOMErrfs}/sorc/_workaround_/MPASBlend/build.sh" "${HOMErrfs}/sorc/MPASBlend/build.sh"
  [[ -f "${HOMErrfs}/sorc/_workaround_/MPASBlend/build.gaeac7.intel.lua" ]] && cp "${HOMErrfs}/sorc/_workaround_/MPASBlend/build.gaeac7.intel.lua" "${HOMErrfs}/sorc/MPASBlend/modulefiles/build.gaeac7.intel.lua"
fi

cd "${HOMErrfs}/sorc/MPASBlend" || exit 1
./build.sh

mkdir -p "${HOMErrfs}/exec"
echo "copy ${EXEC} to ../exec/mpas_blending.x"
cp "${EXEC}" "${HOMErrfs}/exec/mpas_blending.x"

exit 0
